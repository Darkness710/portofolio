---

---

<section id="home" class="flex min-h-screen items-center px-6">
  <div
    class="mx-auto grid max-w-5xl items-center gap-16 lg:grid-cols-[1.1fr_0.9fr]"
  >
    <!-- Kolom teks -->
    <div>
      <p class="mb-4 flex items-center gap-2 text-sm text-gold">
        <span class="h-px w-8 bg-gold"></span>
        Halo, saya
      </p>

      <h1
        class="font-display text-4xl leading-tight text-ivory sm:text-5xl lg:text-6xl"
      >
        Shiddiq Saiful Majid.
      </h1>

      <p class="mt-4 font-display text-xl text-ivory/70 sm:text-2xl">
        Software Developer yang fokus bikin
        <span class="text-gold">antarmuka web yang rapi & cepat</span>.
      </p>

      <p class="mt-6 max-w-md text-ivory/60">
        Terbiasa kerja dengan Vue.js, Astro, dan Tailwind CSS untuk membangun
        produk yang bersih secara desain maupun kode.
      </p>
    </div>
  </div>

  <!-- Kolom foto -->
  <div class="relative mx-auto w-full max-w-xs lg:max-w-sm">
    <div
      class="absolute -bottom-4 -right-4 h-full w-full rounded-2xl border border-dashed border-gold/60"
    >
    </div>
    <div class="relative overflow-hidden rounded-2xl">
      <img
        src="/images/profile.jpg"
        alt="Shiddiq Saiful Majid"
        class="aspect-[4/5] w-full object-cover grayscale transition-all duration-500 hover:grayscale-0"
      />
    </div>
  </div>
</section>
